# Copy to .env and fill in. .env is git-ignored; never commit it.

# Needed for the agents (P4) and for labelling text not yet in the label cache.
ANTHROPIC_API_KEY=

# Neo4j (docker-compose.yml reads these too). Password must be at least 8 characters.
NEO4J_PASSWORD=halyard-local
NEO4J_USER=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Which client config under config/ to use.
HALYARD_CLIENT=brewbird
