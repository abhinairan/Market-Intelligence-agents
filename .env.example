# Copy to .env and fill in. .env is git-ignored; never commit it.

# LLM provider: openai or anthropic. Needed for the agents (P4) and for labelling
# text not yet in the label cache. Only the chosen provider's key is required.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model IDs for the chosen provider. The committed label cache (data/cache/labels.jsonl) was
# filled with openai / gpt-6-luna; keep those two to rebuild without any labelling calls.
# The agents and the recorded eval ran on gpt-6-luna.
LABEL_MODEL=gpt-6-luna
AGENT_MODEL=gpt-6-luna
# The eval's rubric judge (`halyard eval`). gpt-6-luna was chosen (14 Oct); it is checked
# against a stronger model with `halyard eval --second-judge gpt-6.1-sol`.
JUDGE_MODEL=gpt-6-luna

# Neo4j (docker-compose.yml reads these too). Password must be at least 8 characters.
NEO4J_PASSWORD=halyard-local
NEO4J_USER=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Which client config under config/ to use.
HALYARD_CLIENT=brewbird
